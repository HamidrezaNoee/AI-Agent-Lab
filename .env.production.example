# Duplicate as .env.production, then set private values in your password vault.
# NEVER put this file in Git or paste credential values into chat.
# SQL must be the operational EnterpriseProcess2 (never EnterpriseProcess2_AI_Test).
AVAN_SQL_SERVER=host.docker.internal,1433
AVAN_SQL_DATABASE=EnterpriseProcess2
AVAN_SQL_USER=AVAN_Reader
AVAN_SQL_PASSWORD=SET_SECURE_READONLY_SQL_PASSWORD
# Preferred: no (SQL TLS server cert trusted by container CA).
# yes is an explicit, temporary exception for a reviewed internal self-signed SQL cert.
AVAN_SQL_TRUST_SERVER_CERTIFICATE=no

# Local-only first deployment; reverse proxy HTTPS is required before public access.
AVAN_PUBLIC_ORIGIN=http://127.0.0.1:8188
AVAN_ALLOWED_HOSTS=127.0.0.1,localhost
AVAN_DATA_TIMEZONE=Asia/Tehran

# Required: publisher-signed LIMAK license for this exact tenant and installation.
# Generate a stable random 64-character hex installation ID once and retain it.
# Never put the private ECDSA signing key on the customer server.
AVAN_INSTALLATION_ID=SET_STABLE_64_CHARACTER_HEX_INSTALLATION_ID


# These Keycloak/IdP URLs must belong to the SAME organization realm.
# The confidential Authorization Code + PKCE client must have exactly
# http://127.0.0.1:8188/auth/callback as its allowed redirect URI.
COMMERCIAL_OIDC_ISSUER=https://YOUR_REAL_IDP/realms/avan
COMMERCIAL_OIDC_AUDIENCE=YOUR_API_AUDIENCE
COMMERCIAL_OIDC_JWKS_URL=https://YOUR_REAL_IDP/realms/avan/protocol/openid-connect/certs
COMMERCIAL_OIDC_AUTHORIZATION_URL=https://YOUR_REAL_IDP/realms/avan/protocol/openid-connect/auth
COMMERCIAL_OIDC_TOKEN_URL=https://YOUR_REAL_IDP/realms/avan/protocol/openid-connect/token
COMMERCIAL_OIDC_CLIENT_ID=YOUR_CONFIDENTIAL_OIDC_CLIENT
AVAN_OIDC_CLIENT_SECRET=SET_SECURE_CONFIDENTIAL_CLIENT_SECRET
