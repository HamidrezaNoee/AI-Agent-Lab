FROM python:3.13-slim
RUN pip install --no-cache-dir "httpx>=0.27,<1" "jdatetime>=5,<6"
WORKDIR /app
COPY commercial/__init__.py /app/commercial/__init__.py
COPY commercial/scenarios /app/commercial/scenarios
ENV PYTHONPATH=/app
WORKDIR /data
ENTRYPOINT ["python", "-m", "commercial.scenarios.processmaker_import"]
