# Copy to .env.connected-lab; never commit the copy or paste passwords into chat.
# The connected panel FAILS CLOSED until an authorized real HTTPS IdP and SQL lab
# memberships have been configured. These are EXAMPLES, not live credentials.
COMMERCIAL_SQL_SERVER=host.docker.internal,1433
COMMERCIAL_SQL_USER=AI_CommercialReader
COMMERCIAL_SQL_PASSWORD=REPLACE_WITH_RESTRICTED_TEST_SQL_PASSWORD
COMMERCIAL_DIRECTORY_SQL_USER=AI_CommercialDirectoryAdmin
COMMERCIAL_DIRECTORY_SQL_PASSWORD=REPLACE_WITH_SEPARATE_TEST_DIRECTORY_PASSWORD
COMMERCIAL_PLATFORM_SQL_USER=AI_CommercialPlatformAdmin
COMMERCIAL_PLATFORM_SQL_PASSWORD=REPLACE_WITH_SEPARATE_TEST_PLATFORM_PASSWORD

COMMERCIAL_OIDC_ISSUER=https://YOUR_AUTHORIZED_IDP/realms/meeting
COMMERCIAL_OIDC_AUDIENCE=YOUR_MEETING_API_AUDIENCE
COMMERCIAL_OIDC_JWKS_URL=https://YOUR_AUTHORIZED_IDP/realms/meeting/protocol/openid-connect/certs
COMMERCIAL_OIDC_AUTHORIZATION_URL=https://YOUR_AUTHORIZED_IDP/realms/meeting/protocol/openid-connect/auth
COMMERCIAL_OIDC_TOKEN_URL=https://YOUR_AUTHORIZED_IDP/realms/meeting/protocol/openid-connect/token
COMMERCIAL_OIDC_CLIENT_ID=YOUR_REGISTERED_PUBLIC_SPA_CLIENT_ID
COMMERCIAL_OIDC_SCOPES=openid profile

# Keep enabled values OFF until PM REST read-only OAuth and Keycloak admin
# have been separately approved and tested in the isolated lab.
COMMERCIAL_PM_SYNC_ENABLED=0
COMMERCIAL_KEYCLOAK_ADMIN_ENABLED=0
COMMERCIAL_PLATFORM_LICENSE_ENABLED=0
